module vrm

import json
import glb

type VrmVersion =
  | V0
  | V1
  | Unknown

fn version_string(v: VrmVersion) -> String =
  match v {
    V0 => "0.x",
    V1 => "1.0",
    Unknown => "unknown",
  }

type Vrm = {
  glb: glb.GlbFile,
  version: VrmVersion,
}

fn empty() -> Vrm = {
  let g = glb.GlbFile { json_data: value.null(), bin_data: bytes.zeros(0) }
  Vrm { glb: g, version: Unknown }
}

effect fn load(path: String) -> Result[Vrm, String] = {
  let g = match glb.load(path) {
    ok(g) => g,
    err(_) => err("failed to load GLB"),
  }
  let v = detect_version(g.json_data)
  ok(Vrm { glb: g, version: v })
}

effect fn save(vrm: Vrm, path: String) -> Result[Unit, String] =
  glb.save(vrm.glb, path)

fn detect_version(j: json.Value) -> VrmVersion = {
  let ext = value.get(j, "extensions")
  match ext {
    none => Unknown,
    some(e) =>
      if option.is_some(value.get(e, "VRMC_vrm")) then V1
      else if option.is_some(value.get(e, "VRM")) then V0
      else Unknown,
  }
}

fn extensions(vrm: Vrm) -> Option[json.Value] =
  value.get(vrm.glb.json_data, "extensions")

fn vrm_root(vrm: Vrm) -> Option[json.Value] =
  match extensions(vrm) {
    none => none,
    some(ext) => match vrm.version {
      V1 => value.get(ext, "VRMC_vrm"),
      V0 => value.get(ext, "VRM"),
      Unknown => none,
    },
  }

fn meta(vrm: Vrm) -> Option[json.Value] =
  match vrm_root(vrm) {
    some(root) => value.get(root, "meta"),
    none => none,
  }

fn title(vrm: Vrm) -> String = {
  let key = if vrm.version == V1 then "name" else "title"
  match meta(vrm) {
    some(m) => value.get_string(m, key) ?? "",
    none => "",
  }
}

fn author(vrm: Vrm) -> String =
  match meta(vrm) {
    some(m) => match vrm.version {
      V1 => match value.get_array(m, "authors") {
        some(arr) => {
          let strs = list.filter_map(arr, (x) => value.as_string(x)?)
          list.join(strs, ", ")
        },
        none => "",
      },
      _ => value.get_string(m, "author") ?? "",
    },
    none => "",
  }

fn human_bones(vrm: Vrm) -> List[json.Value] =
  match vrm_root(vrm) {
    none => [],
    some(root) => match value.get(root, "humanoid") {
      none => [],
      some(h) => match vrm.version {
        V1 => match value.get(h, "humanBones") {
          some(bones) => {
            let entries = (value.as_object(bones) ?? []) |> list.map(((k, _)) => k)
            list.map(entries, (name) => {
              let node = match value.get(bones, name) {
                some(b) => value.get_int(b, "node") ?? -1,
                none => -1,
              }
              value.object([("bone", value.string(name)), ("node", value.int(node))])
            })
          },
          none => [],
        },
        V0 => value.get_array(h, "humanBones") ?? [],
        Unknown => [],
      },
    },
  }

fn expression_count(vrm: Vrm) -> Int =
  match vrm_root(vrm) {
    none => 0,
    some(root) => match vrm.version {
      V1 => {
        let expr = value.get(root, "expressions") ?? value.null()
        let preset = match value.get(expr, "preset") {
          some(p) => list.len(value.as_object(p) ?? []),
          none => 0,
        }
        let custom = match value.get(expr, "custom") {
          some(c) => list.len(value.as_object(c) ?? []),
          none => 0,
        }
        preset + custom
      },
      V0 => {
        let bsm = value.get(root, "blendShapeMaster") ?? value.null()
        match value.get_array(bsm, "blendShapeGroups") {
          some(g) => list.len(g),
          none => 0,
        }
      },
      Unknown => 0,
    },
  }

fn count(j: json.Value, key: String) -> Int =
  match value.get_array(j, key) {
    some(a) => list.len(a),
    none => 0,
  }

fn summary(vrm: Vrm) -> json.Value =
  value.object([
    ("version", value.string(version_string(vrm.version))),
    ("title", value.string(title(vrm))),
    ("author", value.string(author(vrm))),
    ("meshes", value.int(count(vrm.glb.json_data, "meshes"))),
    ("nodes", value.int(count(vrm.glb.json_data, "nodes"))),
    ("materials", value.int(count(vrm.glb.json_data, "materials"))),
    ("textures", value.int(count(vrm.glb.json_data, "textures"))),
    ("images", value.int(count(vrm.glb.json_data, "images"))),
    ("human_bones", value.int(list.len(human_bones(vrm)))),
    ("expressions", value.int(expression_count(vrm))),
  ])
