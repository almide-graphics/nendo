// glTF mesh → obsid vertex buffers. Zero-copy from GLB binary.
//
// obsid vertex: pos[3] + norm[3] + color[3] + uv[2] = 11 floats = 44 bytes
// obsid index: u16

module mesh

import json
import bytes
import accessor

type MeshData = {
  vertices: Bytes,
  indices: Bytes,
  vert_count: Int,
  idx_count: Int,
  morph_count: Int,    // number of morph targets
}

// Apply morph targets to vertex buffer in-place.
// prim: the primitive JSON (has "targets" array)
// weights: Bytes of morph_count × float32 LE
fn apply_morph(gltf_json: json.Value, bin: Bytes, bin_offset: Int, prim: json.Value, verts: Bytes, vert_count: Int, out_stride: Int, weights: Bytes) -> Unit = {
  let targets = option.unwrap_or(value.get_array(prim, "targets"), [])
  var ti = 0
  while ti < list.len(targets) {
    let w = bytes.get_f32_le(weights, ti * 4) ?? 0.0
    if w > 0.001 or w < -0.001 then {
      let target = list.get(targets, ti) ?? value.null()
      let pos_delta_idx = option.unwrap_or(value.get_int(target, "POSITION"), -1)
      if pos_delta_idx >= 0 then {
        match accessor.resolve(gltf_json, pos_delta_idx) {
          some(di) => {
            var vi = 0
            while vi < vert_count {
              let dst = vi * out_stride
              let src = bin_offset + di.base_offset + vi * di.stride
              // Add weighted delta to position
              let dx = bytes.get_f32_le(bin, src) ?? 0.0 * w
              let dy = bytes.get_f32_le(bin, src + 4) ?? 0.0 * w
              let dz = bytes.get_f32_le(bin, src + 8) ?? 0.0 * w
              bytes.put_f32_le(verts, dst, bytes.get_f32_le(verts, dst) ?? 0.0 + dx)
              bytes.put_f32_le(verts, dst + 4, bytes.get_f32_le(verts, dst + 4) ?? 0.0 + dy)
              bytes.put_f32_le(verts, dst + 8, bytes.get_f32_le(verts, dst + 8) ?? 0.0 + dz)
              vi = vi + 1
            }
          },
          none => {},
        }
      } else {}
    } else {}
    ti = ti + 1
  }
}

// Returns the primitives list for a mesh (caller iterates with build_primitive).
fn get_primitives(gltf_json: json.Value, mesh_idx: Int) -> List[json.Value] = {
  let meshes = option.unwrap_or(value.get_array(gltf_json, "meshes"), [])
  if list.len(meshes) <= mesh_idx then []
  else {
    let mesh_val = list.get(meshes, mesh_idx) ?? value.null()
    option.unwrap_or(value.get_array(mesh_val, "primitives"), [])
  }
}

fn build_primitive(gltf_json: json.Value, bin: Bytes, bin_offset: Int, prim: json.Value) -> Option[MeshData] = {
  let attrs = option.unwrap_or(value.get(prim, "attributes"), value.null())
  let pos_idx = option.unwrap_or(value.get_int(attrs, "POSITION"), -1)
  if pos_idx < 0 then none
  else {
  let pos_info = accessor.resolve(gltf_json, pos_idx)
  if option.is_none(pos_info) then none
  else {
  let pi = option.unwrap_or(pos_info, accessor.AccessorInfo { base_offset: 0, count: 0, components: 0, comp_size: 0, stride: 12 })
  let vert_count = pi.count
  let pos_stride = pi.stride

  let has_normal = option.is_some(value.get_int(attrs, "NORMAL"))
  let norm_idx = option.unwrap_or(value.get_int(attrs, "NORMAL"), -1)
  let norm_info = if has_normal then accessor.resolve(gltf_json, norm_idx) else none
  let ni_base = match norm_info { some(ni) => ni.base_offset, none => 0 }
  let norm_stride = match norm_info { some(ni) => ni.stride, none => 12 }

  let has_uv = option.is_some(value.get_int(attrs, "TEXCOORD_0"))
  let uv_idx = option.unwrap_or(value.get_int(attrs, "TEXCOORD_0"), -1)
  let uv_info = if has_uv then accessor.resolve(gltf_json, uv_idx) else none
  let uv_base = match uv_info { some(ui) => ui.base_offset, none => 0 }
  let uv_stride = match uv_info { some(ui) => ui.stride, none => 8 }

  // Material base color
  let mat_idx = option.unwrap_or(value.get_int(prim, "material"), -1)
  let base_r = get_color_component(gltf_json, mat_idx, 0)
  let base_g = get_color_component(gltf_json, mat_idx, 1)
  let base_b = get_color_component(gltf_json, mat_idx, 2)

  let out_stride = 44
  let verts = bytes.zeros(vert_count * out_stride)
  var i = 0
  while i < vert_count {
    let dst = i * out_stride
    bytes.copy_from(verts, bin, dst, bin_offset + pi.base_offset + i * pos_stride, 12)

    if has_normal then {
      bytes.copy_from(verts, bin, dst + 12, bin_offset + ni_base + i * norm_stride, 12)
    } else {
      bytes.put_f32_le(verts, dst + 12, 0.0)
      bytes.put_f32_le(verts, dst + 16, 1.0)
      bytes.put_f32_le(verts, dst + 20, 0.0)
    }

    bytes.put_f32_le(verts, dst + 24, base_r)
    bytes.put_f32_le(verts, dst + 28, base_g)
    bytes.put_f32_le(verts, dst + 32, base_b)
    // UV: copy from TEXCOORD_0 or write (0,0)
    if has_uv then {
      bytes.copy_from(verts, bin, dst + 36, bin_offset + uv_base + i * uv_stride, 8)
    } else {
      bytes.put_f32_le(verts, dst + 36, 0.0)
      bytes.put_f32_le(verts, dst + 40, 0.0)
    }
    i = i + 1
  }

  // Indices — obsid expects u16, glTF may use u16(5123) or u32(5125)
  let idx_acc = option.unwrap_or(value.get_int(prim, "indices"), -1)
  let idx_info = if idx_acc >= 0 then accessor.resolve(gltf_json, idx_acc) else none
  let idx_count = match idx_info { some(ii) => ii.count, none => 0 }
  let idx_data = bytes.zeros(idx_count * 2)
  match idx_info {
    some(ii) => {
      if ii.comp_size == 2 then {
        bytes.copy_from(idx_data, bin, 0, bin_offset + ii.base_offset, idx_count * 2)
      } else {
        var j = 0
        while j < idx_count {
          let val = bytes.get_u32_le(bin, bin_offset + ii.base_offset + j * 4) ?? 0
          bytes.put_u16_le(idx_data, j * 2, val)
          j = j + 1
        }
      }
    },
    none => {},
  }

  let morph_count = list.len(option.unwrap_or(value.get_array(prim, "targets"), []))
  some(MeshData { vertices: verts, indices: idx_data, vert_count: vert_count, idx_count: idx_count, morph_count: morph_count })
  }
  }
}

fn get_color_component(gltf_json: json.Value, mat_idx: Int, idx: Int) -> Float = {
  if mat_idx < 0 then 0.8
  else {
    // Try VRM 0.x MToon _Color first
    let vrm_color = get_vrm0_color(gltf_json, mat_idx, idx)
    if vrm_color >= 0.0 then vrm_color
    else {
      // Fallback to PBR baseColorFactor
      let materials = option.unwrap_or(value.get_array(gltf_json, "materials"), [])
      match list.get(materials, mat_idx) {
        none => 0.8,
        some(mat) => match value.get(mat, "pbrMetallicRoughness") {
          none => 0.8,
          some(pbr) => match value.get_array(pbr, "baseColorFactor") {
            none => 0.8,
            some(arr) => option.unwrap_or(value.as_float(list.get(arr, idx) ?? value.float(0.8))?, 0.8),
          },
        },
      }
    }
  }
}

// VRM 0.x: extensions.VRM.materialProperties[mat_idx].vectorProperties._Color[idx]
// Returns -1.0 if not found.
fn get_vrm0_color(gltf_json: json.Value, mat_idx: Int, idx: Int) -> Float = {
  match value.get(gltf_json, "extensions") {
    none => -1.0,
    some(ext) => match value.get(ext, "VRM") {
      none => -1.0,
      some(vrm) => match value.get_array(vrm, "materialProperties") {
        none => -1.0,
        some(props) => match list.get(props, mat_idx) {
          none => -1.0,
          some(prop) => match value.get(prop, "vectorProperties") {
            none => -1.0,
            some(vp) => match value.get_array(vp, "_Color") {
              none => -1.0,
              some(arr) => option.unwrap_or(value.as_float(list.get(arr, idx) ?? value.float(-1.0))?, -1.0),
            },
          },
        },
      },
    },
  }
}
